# ---------------------------------------------------------------
# MODO SINGULAR — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel (produção).
# NUNCA versione valores reais: .env.local está no .gitignore.
# ---------------------------------------------------------------

# URL pública do app (usada nos e-mails de recuperação de senha)
NEXT_PUBLIC_SITE_URL=https://modosingular.com.br

# --- Supabase --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key
# Somente no servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# --- Kiwify ----------------------------------------------------
# Token do webhook: aparece no painel da Kiwify ao criar o webhook.
# É com ele que a assinatura HMAC-SHA1 do corpo é validada.
KIWIFY_WEBHOOK_TOKEN=
# Credenciais da API pública (opcional — usadas para reconciliar assinaturas)
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=
KIWIFY_ACCOUNT_ID=

# ---------------------------------------------------------------
# Nomes sem prefixo (recomendados na Vercel)
# O app acessa o Supabase só pelo servidor, então o prefixo NEXT_PUBLIC_
# é dispensável — e sem ele a Vercel não exibe o aviso de exposição.
# Use ESTES ou os NEXT_PUBLIC_ acima; os dois funcionam.
# ---------------------------------------------------------------
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_ANON_KEY=sua_chave_publishable
